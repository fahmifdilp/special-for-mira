# Set these in Vercel Project Settings > Environment Variables. Never commit a real key.
ADACODE_API_KEY=replace_with_your_adacode_api_key
ADACODE_MODEL=adacode-2.5-flash
# Used only by the explicit-consent share action, never by /api/dino-chat.
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_your_telegram_chat_id
